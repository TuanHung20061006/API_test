FLASK_ENV=production
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_SECRET_KEY=replace-with-a-different-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
DATABASE_URL=postgresql+psycopg://planventure:replace-me@postgres:5432/planventure
CORS_ORIGINS=https://app.example.com
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=redis://redis:6379/2
MAX_CONTENT_LENGTH_BYTES=1048576
WEATHER_API_KEY=replace-with-weatherapi-key
WEATHER_API_BASE_URL=https://api.weatherapi.com/v1
WEATHER_API_CONNECT_TIMEOUT_SECONDS=3.05
WEATHER_API_READ_TIMEOUT_SECONDS=8
WEATHER_CACHE_TTL_SECONDS=900
WEATHER_RATE_LIMIT=30 per minute;300 per day
CACHE_TYPE=RedisCache
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=planventure:production:
CACHE_REDIS_URL=redis://redis:6379/1
